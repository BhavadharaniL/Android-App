{
  "name": "careerverse-backend",
  "version": "1.0.0",
  "description": "CareerVerse Backend REST API with Live Data Synchronization, AI RAG, and Security",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test tests/**/*.test.js",
    "seed": "node seed/seedDemoData.js",
    "sync": "node -e \"const { connectDB } = require('./config/db'); connectDB().then(() => require('./services/syncService').syncAllSources()).then(() => process.exit(0))\""
  },
  "dependencies": {
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "fast-xml-parser": "^4.5.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.1.3",
    "nodemon": "^3.1.9"
  },
  "keywords": [
    "careerverse",
    "career-guidance",
    "live-jobs",
    "rag-ai",
    "scholarships",
    "government-jobs"
  ],
  "author": "CareerVerse Team",
  "license": "ISC"
}
