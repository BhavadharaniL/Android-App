# CareerVerse Backend Environment Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Local MongoDB, MongoDB Atlas, or leave default for automatic development connection
MONGODB_URI=mongodb://127.0.0.1:27017/careerverse

# JWT Authentication
JWT_SECRET=careerverse_jwt_super_secret_key_production_2026
JWT_EXPIRES_IN=7d

# Google Gemini AI API Key (Required for AI Chat, Resume Analyzer, Roadmap & Interview features)
GEMINI_API_KEY=your_gemini_api_key_here

# Job & Opportunity External APIs
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_APP_KEY=your_adzuna_app_key_here

# News External API
NEWS_API_KEY=your_news_api_key_here

# Official Portal Source URLs (Configurable)
NCS_SOURCE_URL=https://www.ncs.gov.in/
UPSC_SOURCE_URL=https://www.upsc.gov.in/
SSC_SOURCE_URL=https://ssc.gov.in/
SCHOLARSHIP_SOURCE_URL=https://scholarships.gov.in/

# Scheduled Synchronization Intervals (Cron expressions or minutes)
SYNC_JOBS_INTERVAL=*/30 * * * *
SYNC_NEWS_INTERVAL=*/15 * * * *
SYNC_GOVERNMENT_INTERVAL=0 */2 * * *
SYNC_SCHOLARSHIP_INTERVAL=0 0 * * *

# Admin Credentials for initialization
ADMIN_EMAIL=admin@careerverse.internal
ADMIN_PASSWORD=AdminSecurePass2026!
