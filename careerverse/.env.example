# CareerVerse Root Environment Template
# Copy this to backend/.env and customize your keys

PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/careerverse
JWT_SECRET=careerverse_jwt_super_secret_key_production_2026
JWT_EXPIRES_IN=7d

# External APIs
GEMINI_API_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
NEWS_API_KEY=

# Live Source Feeds
NCS_SOURCE_URL=https://www.ncs.gov.in/
UPSC_SOURCE_URL=https://www.upsc.gov.in/
SSC_SOURCE_URL=https://ssc.gov.in/
SCHOLARSHIP_SOURCE_URL=https://scholarships.gov.in/

# Sync Intervals
SYNC_JOBS_INTERVAL=*/30 * * * *
SYNC_NEWS_INTERVAL=*/15 * * * *
SYNC_GOVERNMENT_INTERVAL=0 */2 * * *
SYNC_SCHOLARSHIP_INTERVAL=0 0 * * *

# Mobile API URL (Use your machine's Wi-Fi IP e.g. http://192.168.1.100:5000 for physical phone)
EXPO_PUBLIC_API_URL=http://10.241.247.177:5000/api
